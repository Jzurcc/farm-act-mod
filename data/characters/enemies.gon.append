FA_Cow1 {
    graphics {
        movieclip _CAT
        name "ENEMY_FA_COW_NAME"
        custom_cat_data FA_Cow
        tooltip "ENEMY_FA_COW_DESC"
        scale 1.3
        shadow_size 1.3
    }

    stats {
        strength 6
        speed 2
    }

    properties {
        faction enemies
        health 18
        movement 2
    }

    abilities {
        move DefaultMove
        attack BasicTankMelee

        spells [
            FA_Cowlick
            FA_CowEnrage
        ]
    }

    passives {
        Buddy FA_Cow2
        AbilityWhenBuddyDies FA_CowEnrage

        FormChanger {
            initial_form Default
            Default {}
            Enraged {
                passives {
                    EliteTint [1 0 0 .25]
                    SpeedUp 2
                    AmplifyKnockback 3
                    AddStatusToBasicAttack {
                        Bruise 1
                    }
                }

                ai {
                    brain PatternBrain
                    decision_weights default
                    move_weights stay_close

                    pattern {
                        do attack
                    }
                }
            }
        }
    }

    ai {
        brain PatternBrain
        decision_weights default_no_revive
        move_weights keep_distance_always_move

        pattern {
            do_priority [FA_Cowlick attack]
            do_priority [attack FA_Cowlick]
        }
    }
}

FA_Cow2 {
    variant_of FA_Cow1

    passives {
        Buddy FA_Cow1
    }
}

