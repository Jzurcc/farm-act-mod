# Farm Chapter

FA_Tractor {
    graphics {
        movieclip MechSuit
        name "ENEMY_FA_TRACTOR_NAME"
        uifloaters_offset 2
        shadow_size 2
        move_speed_sync_frames 27

        tooltip "ENEMY_FA_TRACTOR_DESC"
    }

    stats {
        strength 6
        dexterity 5
        constitution 5
        intelligence 5
        speed 4
        charisma 5
        luck 5
    }

    properties {
        tag [mount]
        faction enemies
        size 2x2
        move_block everything_even_when_dead
        health 5
        movement 4
        shield 25
    }

    abilities {
        move DefaultMove
        attack FA_TractorDash
    }

    passives {
        Trample 1
        DeathRattle FA_Tractor_UnmountFarmerCat
        DeathRattle {
            ability FA_Tractor_Explode
            pop_corpse true
            is_dying_animation true
        }
    }

    ai {
        brain PatternBrain

        pattern {
            do_all [move attack]
        }
        decision_weights default
        move_weights stay_close
    }
}

