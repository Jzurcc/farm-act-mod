FA_Wanderer {
    graphics {
        movieclip SpiderQueen
        name "ENEMY_FA_WANDERER_NAME"
        scale 0.8
        shadow_size 1.8
        uifloaters_offset 2
        water_mask medium
        move_speed_sync_frames 7
		tooltip "ENEMY_FA_WANDERER_DESC"
    }

    stats {
        strength 4
        speed 3
    }

    properties {
        tag bug
        faction enemies
        movement 3
        mana_regen 999
        mana 100
        health 25

        size 2x2
        move_block everything_even_when_dead
    }

    abilities {
        move DefaultMove
        attack BasicBigMelee

        spells [
            FA_WandererArm
            FA_WandererAmbushStrike
            FA_WandererEnrage
            FA_WandererCalmDown
        ]
    }

    passives {
        AddStatusToBasicAttack {
            Poison 1
        }
        EliteTint [.75 .55 .35 .55]

        FormChanger {
            initial_form Default

            Default {
                passives {
                    ImmediateAbilityReaction {
                        ability FA_WandererArm
                    }
                    ImmediateAbilityReaction {
                        ability FA_WandererEnrage
                        backstabs_only true
                    }
                }

                ai {
                    brain PatternBrain
                    decision_weights default
                    move_weights stay_close_always_move
                    pattern {
                        do attack
                    }
                }
            }

            Armed {
                passives {
                    EliteTint [1 1 1 .4]
                    MovementReaction {
                        ability FA_WandererAmbushStrike
                        forward_only true
                        enemies_only true
                    }
                    ImmediateAbilityReaction {
                        ability FA_WandererEnrage
                        backstabs_only true
                    }
                }

                ai {
                    brain PatternBrain
                    decision_weights default
                    move_weights stay_close
                    pattern {
                        do attack
                    }
                }
            }

            Enraged {
                animation_suffix "Insane"

                passives {
                    EliteTint [1 0 0 .25]
                    StrengthUp 4
                    SpeedUp 3
                    AddMovement 2
                }

                ai {
                    brain PatternBrain
                    decision_weights careless
                    move_weights stay_close_always_move
                    pattern {
                        do attack
                        do_all [attack FA_WandererCalmDown]
                    }
                }
            }
        }
    }
}

