FA_TractorDash {
    template trample_dash

    target {
        min_aoe 2
        max_aoe 2
        max_range 3
        aoe_considers_character_size true
    }

    damage_instance {
        effects {
            VaporizeInanimate 1
            Bruise 1
        }
    }
}

FA_Tractor_Explode {
    template spell

    graphics {
        dont_orient true
        particle Explosion
        animation none
    }

    target {
        aoe_mode circle
        knockback_mode character_to_tile
        
        target_mode none
        min_range 0
        max_range 0
        min_aoe 0
        max_aoe 2
    }

    damage_instance {
        damage 5
        knockback 1

        elements [
            Explosion
        ]
    }

    self_damage {
        damage 0
        effects {
            ImmediateUseAbility_Instant FA_Tractor_UnmountFarmerCat
        }
    }
}

FA_Tractor_UnmountFarmerCat {
    template spawn
    
    graphics {
        lob true
    }

    target {
		exclude_self true
		target_mode random_tile
		min_range 2
		max_range 2
	}

    spawn {
		object FA_FarmerCat
	}
    
}

FA_ShepherdGoop {
    variant_of CatGoop

    graphics {
        projectile Poisonball
    }

    damage_instance {
        damage 2+bonus_ranged_damage
        effects {
            Poison 1
        }

        elements [
            Poison
        ]
    }
}

// TODO: Make this a cant_cast 2-X so it's usable twice in one turn instead of multihit
IsaacBasicAttack_2Hits {
    variant_of IsaacBasicAttack
    target {
        multihit 2
    }
}

FA_OnionBomb_Explode {
    variant_of FA_Tractor_Explode

    graphics {
        particle PoisonPoof
    }

    damage_instance {
        damage 7
        effects {
            Poison 2
        }
        elements [
            Poison
        ]
    }
}

FA_Cowlick {
    template melee_attack

    graphics {
        animation lickAttack
    }
    
    cost {
        mana 0
    }
    
    damage_instance {
        ai_base_score 10
        heal 3

        effects {
            Cleanse 0
        }

        custom_additional_ai_weight must_target_buddy
    }
}

FA_CowEnrage {
    template self_buff

    graphics {
        animation angry
    }

    damage_instance {
        effects {
            FormChange {
                form "Enraged"
            }
        }
        ai_base_score 9999
    }
}

// TODO: since neutral birds can't be targeted, change to prioritize allied or enemy birds instead
BasicRanged_Fox {
    template straightshot_attack

    meta {
        name ""
        animate_name false
    }

    graphics {
        animation weaponthrowstraight
        projectile knifeprojectile
    }

    cost {
        mana 0
        act_points 1
    }

    target {
        restrictions [must_have_tag]
        target_requires_tag bird
        min_aoe 1
        max_aoe 4
    }

    damage_instance {
        damage 5+bonus_melee_damage
        ai_base_score 10
        effects {
            Conditional_HasTag {
                tag bird
                DoDamage {
                    damage 999
                    type melee
                }
            }
        }
    }
}

FA_GoatChainDash {
    variant_of ChainDash
    temporary_effects {
        DashFury 3
    }
}

FA_WoolyRamChainDash {
    variant_of ChainDash
    temporary_effects {
        DashFury 2
    }
}